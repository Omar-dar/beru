# Copy useful lines into your .env (merge with existing vars).

# --- Fast replies (recommended for voice chat) ---
BERU_FAST=1

# Speech-to-text: smaller = faster (tiny/base/small/medium)
BERU_WHISPER_MODEL=small
BERU_WHISPER_BEAM_SIZE=1
BERU_WHISPER_VAD=0
BERU_PRELOAD_VOICE=1

# Ollama: keep warm; shorter replies = faster
BERU_OLLAMA_PRELOAD=1
BERU_OLLAMA_MODEL=llama3.2:3b
BERU_OLLAMA_NUM_PREDICT_SHORT=60
BERU_OLLAMA_CONTEXT_MESSAGES=6

# Skip slow extra Ollama call for ambiguous computer commands
BERU_COMPUTER_BRAIN_NLU=0

# Voice auth (no password)
BERU_VOICE_AUTH=1

# Optional: log stt/chat ms on /voice/chat responses
# BERU_DEBUG_TIMING=1

# If you have an NVIDIA GPU:
# BERU_WHISPER_DEVICE=cuda
# BERU_WHISPER_COMPUTE_TYPE=float16
